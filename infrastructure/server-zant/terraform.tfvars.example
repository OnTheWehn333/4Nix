# Defaults are declared in variables.tf. Add only intentional overrides to the
# ignored terraform.tfvars; this example leaves all defaults in effect.

# Fi is enabled by default at 10.100.0.30. Verify its image in
# result-server-fi before provisioning it.

# On a fresh replacement host, disable the TrueNAS pool and both VMs until
# their storage and image prerequisites have been checked.
# enable_truenas_pool = false
# enable_server_gohdan = false
# enable_server_fi = false
